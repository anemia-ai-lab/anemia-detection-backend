# Render / production — copiar al dashboard (Environment) del Web Service.
# No commitear secretos reales. Ver también .env.example y docs/RUNBOOK.md.

APP_ENV=production
DEBUG=false

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

METRICS_BEARER_TOKEN=GENERATE_STRONG_RANDOM_TOKEN

TRUST_PROXY_HEADERS=true
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_ORIGIN

PREDICTIONS_STORAGE_BUCKET=prediction-images

MODEL_VERSION=v2.0
INFERENCE_MODEL_PATH=ml/artifacts/models/baseline_mobilenetv2_ghana_augmented_seed42.keras
INFERENCE_MODEL_PATHS=ml/artifacts/models/baseline_mobilenetv2_ghana_augmented_seed42.keras,ml/artifacts/models/baseline_mobilenetv2_ghana_augmented_seed123.keras,ml/artifacts/models/baseline_mobilenetv2_ghana_augmented_seed456.keras
INFERENCE_CALIBRATION_TEMPERATURE=1.405026093389256
INFERENCE_CALIBRATION_OPERATIONAL_THRESHOLD=0.3815443834698594
INFERENCE_RISK_TIER_LOW_UPPER=0.3243127259493805
INFERENCE_RISK_TIER_HIGH_LOWER=0.3815443834698594

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_PREDICT_REQUESTS=30

PREDICTION_IMAGE_MAX_BYTES=5242880
PREDICTION_IMAGE_MAX_EDGE_PX=1024
PREDICTION_IMAGE_MAX_PIXELS=12000000

NAIL_PRESENCE_MIN_SKIN_RATIO=0.012

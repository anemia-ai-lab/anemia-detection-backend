# Render — Environment del Web Service (dashboard).
# No commitear secretos reales. Defaults públicos en backend/core/config.py.
# Guía operativa: docs/RUNBOOK.md · smoke prod: make smoke-prod

# -----------------------------------------------------------------------------
# Obligatorio en el dashboard (secretos + overrides sin default seguro)
# -----------------------------------------------------------------------------

APP_ENV=production
DEBUG=false

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

METRICS_BEARER_TOKEN=GENERATE_STRONG_RANDOM_TOKEN

TRUST_PROXY_HEADERS=true

# Ensemble 3× .keras (default INFERENCE_MODEL_PATHS="" → solo 1 modelo en código)
INFERENCE_MODEL_PATHS=ml/artifacts/models/baseline_mobilenetv2_ghana_augmented_seed42.keras,ml/artifacts/models/baseline_mobilenetv2_ghana_augmented_seed123.keras,ml/artifacts/models/baseline_mobilenetv2_ghana_augmented_seed456.keras

# -----------------------------------------------------------------------------
# Opcional — solo si quieres override (si omites, usa default en config.py)
# -----------------------------------------------------------------------------

# MODEL_VERSION=v2.0
# INFERENCE_MODEL_PATH=ml/artifacts/models/baseline_mobilenetv2_ghana_augmented_seed42.keras
# INFERENCE_CALIBRATION_TEMPERATURE=1.405026093389256
# INFERENCE_CALIBRATION_OPERATIONAL_THRESHOLD=0.3815443834698594
# INFERENCE_RISK_TIER_LOW_UPPER=0.3243127259493805
# INFERENCE_RISK_TIER_HIGH_LOWER=0.3815443834698594

# PREDICTIONS_STORAGE_BUCKET=prediction-images  (default: prediction-images)

# RATE_LIMIT_ENABLED=true          (default: true)
# RATE_LIMIT_WINDOW_SECONDS=60     (default: 60)
# RATE_LIMIT_AUTH_REQUESTS=20      (default: 20)
# RATE_LIMIT_PREDICT_REQUESTS=30   (default: 30)

# PREDICTION_IMAGE_MAX_BYTES=5242880       (default: 5242880)
# PREDICTION_IMAGE_MAX_EDGE_PX=1024        (default: 1024)
# PREDICTION_IMAGE_MAX_PIXELS=12000000     (default: 12000000)
# NAIL_PRESENCE_MIN_SKIN_RATIO=0.012       (default: 0.012)

# Solo si un frontend web en otro dominio llama a la API (Swagger en /docs no necesita CORS)
# CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_ORIGIN

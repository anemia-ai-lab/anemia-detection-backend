# AWS ECS Fargate — variables de entorno del task (referencia).
# Secretos reales van en AWS Secrets Manager (`anemia-api/prod`); no commitear valores.
# Guía: docs/DEPLOYMENT_AWS.md · smoke: make smoke-prod

# -----------------------------------------------------------------------------
# Secrets Manager (JSON keys) — obligatorio en producción
# -----------------------------------------------------------------------------

# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_KEY=YOUR_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# METRICS_BEARER_TOKEN=GENERATE_STRONG_RANDOM_TOKEN

# -----------------------------------------------------------------------------
# Task definition (no secretos) — defaults en CDK / backend/core/config.py
# -----------------------------------------------------------------------------

APP_ENV=production
DEBUG=false
TRUST_PROXY_HEADERS=true

INFERENCE_MODEL_PATHS=ml/artifacts/models/baseline_mobilenetv2_ghana_augmented_seed42.keras,ml/artifacts/models/baseline_mobilenetv2_ghana_augmented_seed123.keras,ml/artifacts/models/baseline_mobilenetv2_ghana_augmented_seed456.keras

# PREDICTIONS_STORAGE_BUCKET=prediction-images
# RATE_LIMIT_ENABLED=true
# AUTH_USER_CACHE_TTL_SECONDS=60
# SUPABASE_JWT_SECRET=
# RATE_LIMIT_SYNC_METADATA_REQUESTS=10
# RATE_LIMIT_SYNC_IMAGE_REQUESTS=30
# INFERENCE_TTA_ENABLED=false
# CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_ORIGIN
